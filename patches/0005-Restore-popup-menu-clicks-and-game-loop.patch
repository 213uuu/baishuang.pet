+++ b/desktop_pet.py
@@ -678,6 +678,8 @@ class Pet:
         # Tk 9 在当前桌面环境无法分配原生 Menu，右键菜单改用自绘 Toplevel。
         self._context_menu: tk.Toplevel | None = None
         self._mode_selector: tk.Toplevel | None = None
