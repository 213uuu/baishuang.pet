+$command = Join-Path $env:TEMP ("BaishuangUninstall-" + [guid]::NewGuid().ToString("N") + ".cmd")
+$cleanup = "@echo off`r`ntimeout /t 2 /nobreak >nul`r`nrmdir /s /q `"$InstallDir`"`r`n"
